# The source workbook is 44MB and is committed through Git LFS so the
# repository runs as cloned. Online Retail II is CC BY 4.0, which permits
# redistribution with attribution; the attribution is in README.md and in the
# article's sources.
*.zip  filter=lfs diff=lfs merge=lfs -text
*.xlsx filter=lfs diff=lfs merge=lfs -text

# Keep line endings sane across platforms for everything else.
* text=auto
*.py   text eol=lf
*.md   text eol=lf
*.csv  text eol=lf
*.png  binary
